# ShopSmart AI - Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4000
OPENAI_TIMEOUT_S=25
OPENAI_MAX_RETRIES=0
# Total time budget for one POST /generate (all OpenAI calls); repair is skipped
# when fewer than REPAIR_MIN_REMAINING_S seconds are left
REQUEST_DEADLINE_S=55
REPAIR_MIN_REMAINING_S=20

# Product price catalog (JSON); the app refuses to start if it is invalid
# CATALOG_PATH=app/data/catalog.json
# Menu mode: plans below this many kcal per person and day are sent back for repair
# MIN_KCAL_PER_PERSON_DAY=1600
# Menu mode: portions above this many kcal per person and day are sent back for repair
# MAX_KCAL_PER_PERSON_DAY=3500
# Below this budget per person and day (EUR), food with the highest cost per 1000 kcal
# is not offered to the model (0 turns this off)
# TIGHT_BUDGET_PER_PERSON_DAY=7.0
# Max enum values in the LLM response schema (OpenAI strict mode has a limit);
# above it product ids are plain strings checked by the server
# MAX_SCHEMA_ENUM_VALUES=500

# Comma-separated list of allowed frontend origins ("*" is rejected)
CORS_ORIGINS=http://localhost:3000

# Abuse / cost guards on POST /generate (in-memory, per process)
RATE_LIMIT=10/minute
DAILY_GENERATE_CAP=200

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Environment
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
